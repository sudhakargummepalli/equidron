# Copy to .env for a local run (git ignores .env). Empty values mean "not configured".
# With these empty, emails stay in Ops -> Outbox and the app logs a warning each minute.

# Gmail SMTP. For a personal Gmail account use an App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords), never the account's normal password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
